# Root .dockerignore
# The frontend image is built with the repository root as its context
# (docker build -f Dockerfile.frontend .), so without this the local
# backend/venv/ directory - hundreds of megabytes of installed packages -
# would be shipped to the Docker daemon on every build.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets - never bake these into an image
.env
.env.*
!.env.example

# Data
*.db
*.sqlite
*.sqlite3
backend/data/

# Git
.git/
.github/
.gitignore

# Docs
*.md
!backend/.env.example

# Local artefacts
node_modules/
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
