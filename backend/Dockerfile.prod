# =====================================================================
# A2M Digital Solutions - production backend image
#
# Canonical image for the Oracle Cloud deployment (docker-compose +
# GitHub Actions). The older backend/Dockerfile is kept for the
# Railway/Render PaaS targets; keep the two in sync if you change one.
#
#   docker build -f backend/Dockerfile.prod -t a2m-backend ./backend
# =====================================================================

# --- Stage 1: build wheels --------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Upgrade pip first, use retries and verbose output to diagnose failures.
# Some packages (edge-tts) may need additional system deps; the retries
# handle transient network issues on GitHub Actions runners.
# `--prefix=/install` without `--user` is the standard multi-stage pattern.
# `--user` can cause the packages to be installed in a user-specific
# location that doesn't copy cleanly with `COPY --from=builder /install /usr/local`.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt --retries 3 --timeout 120 -v

# --- Stage 2: runtime --------------------------------------------------
FROM python:3.12-slim

WORKDIR /app

# curl is used by the compose healthcheck fallback; ca-certificates is
# needed for outbound HTTPS calls to the AI providers.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

# Run as a non-root user.
#
# The UID/GID are FIXED at 1000/1000 on purpose. ./backend/data is bind
# mounted from the host (so the inquiry database survives a rebuild), and
# Docker creates a missing bind-mount source directory owned by ROOT. The
# container then runs as a non-root user that cannot write the database.
# Pinning the UID to 1000 - the standard UID of the 'ubuntu' user on the
# Oracle Cloud instance - lets the deploy scripts create the directory as
# the host user and have the container write to it.
RUN groupadd -g 1000 appuser && useradd -u 1000 -g appuser -m appuser

COPY --chown=appuser:appuser . .

# The SQLite database lives in this directory, which is bind-mounted
# from ./backend/data so inquiries survive a container rebuild.
RUN mkdir -p /app/data && chown appuser:appuser /app/data

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DATABASE_URL=sqlite:///./data/inquiries.db

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
