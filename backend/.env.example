# A2M Digital Solutions Backend - Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# App Settings
# ========================================
ENVIRONMENT=development
DEBUG=true
APP_NAME="A2M Digital Solutions API"
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# ========================================
# Database (SQLite - Zero Cost)
# ========================================
DATABASE_URL=sqlite:///./inquiries.db

# ========================================
# CORS Origins
# ========================================
# Add your frontend URLs here (comma-separated)
# The site is served same-origin through nginx, so CORS only matters
# if you ever host the API on a different domain.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5500","http://127.0.0.1:8000","https://a2mdigitalsolutions.com","https://www.a2mdigitalsolutions.com"]

# ========================================
# Email Configuration
# ========================================
# Choose one: gmail, sendgrid, brevo, mailgun, custom
EMAIL_PROVIDER=gmail

# ---- Option 1: Gmail SMTP (Free) ----
# 1. Enable 2FA on your Google account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-char app password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true

# ---- Option 2: Brevo (formerly Sendinblue) - Free 300 emails/day ----
# Sign up at https://www.brevo.com/
# SMTP settings: smtp-relay.brevo.com:587
# SMTP_USERNAME=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key

# ---- Option 3: SendGrid - Free 100 emails/day ----
# Sign up at https://sendgrid.com/
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com

# ---- Option 4: Mailgun - Free tier (requires domain verification) ----
# Sign up at https://www.mailgun.com/
# EMAIL_PROVIDER=mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=your-mailgun-username
# SMTP_PASSWORD=your-mailgun-password

# ========================================
# Email Addresses
# ========================================
FROM_EMAIL=info@a2mdigitalsolutions.com
FROM_NAME="A2M Digital Solutions"
TO_EMAIL=anantamisal@gmail.com

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT=10

# ========================================
# Admin Authentication
# ========================================
# CHANGE THE PASSWORD BEFORE GOING LIVE. The admin user is created from
# these values at startup, and the password is re-synced from this file
# every time the backend boots.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying
# How long an admin session cookie stays valid (hours)
ADMIN_SESSION_HOURS=24
# Set to true in production (the site is served over HTTPS).
# Leave false for local http:// development.
COOKIE_SECURE=false

# ========================================
# AI Agent - provider configuration
# ========================================
# The AI Agent works with NO API KEY on the defaults below.
# Each stage tries the providers left to right and falls back to the
# next one if the current one is missing or fails.

# --- Provider chains (comma separated, tried in order) ---
LLM_PROVIDER_ORDER=nvidia,pollinations,groq
STT_PROVIDER_ORDER=groq
TTS_PROVIDER_ORDER=edge

# --- Pollinations: keyless LLM, no signup required ---
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai-fast

# --- Groq: free tier, one key covers both the LLM and Whisper STT ---
# Get a free key at https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Microsoft Edge TTS: keyless speech synthesis ---
EDGE_TTS_VOICE=en-US-AriaNeural

# --- NVIDIA NIM: optional, server-side only ---
# The key is read by the backend and is NEVER sent to the browser.
# NOTE: meta/llama-3.3-70b-instruct reached end-of-life on 2026-08-26
# and now returns HTTP 410. The model below was verified to be live.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_STT_MODEL=nvidia/parakeet-ctc-0.6b-asr
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_TTS_MODEL=nvidia/parakeet-tts-0.6b-v2
NVIDIA_TTS_VOICE=Magdellene
NVIDIA_TIMEOUT=90
# The Nemotron models are reasoning models: they spend part of the token
# budget thinking out loud and return content: null if the budget is too
# small (measured: 300 tokens -> empty, 1200 tokens -> valid JSON).
NVIDIA_MAX_TOKENS=600