# A2M Digital Solutions Backend - Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# App Settings
# ========================================
ENVIRONMENT=development
DEBUG=true
APP_NAME="A2M Digital Solutions API"
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# ========================================
# Database (SQLite - Zero Cost)
# ========================================
DATABASE_URL=sqlite:///./inquiries.db

# ========================================
# CORS Origins
# ========================================
# Add your frontend URLs here (comma-separated)
# For production, replace with your actual domain
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5500","http://127.0.0.1:8000"]

# ========================================
# Email Configuration
# ========================================
# Choose one: gmail, sendgrid, brevo, mailgun, custom
EMAIL_PROVIDER=gmail

# ---- Option 1: Gmail SMTP (Free) ----
# 1. Enable 2FA on your Google account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-char app password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=anantamisal@gmail.com
SMTP_PASSWORD=xtihhfjuiiojhnxc
SMTP_USE_TLS=true

# ---- Option 2: Brevo (formerly Sendinblue) - Free 300 emails/day ----
# Sign up at https://www.brevo.com/
# SMTP settings: smtp-relay.brevo.com:587
# SMTP_USERNAME=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key

# ---- Option 3: SendGrid - Free 100 emails/day ----
# Sign up at https://sendgrid.com/
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com

# ---- Option 4: Mailgun - Free tier (requires domain verification) ----
# Sign up at https://www.mailgun.com/
# EMAIL_PROVIDER=mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=your-mailgun-username
# SMTP_PASSWORD=your-mailgun-password

# ========================================
# Email Addresses
# ========================================
FROM_EMAIL=info@a2mdigitalsolutions.com
FROM_NAME="A2M Digital Solutions"
TO_EMAIL=info@a2mdigitalsolutions.com

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT=10